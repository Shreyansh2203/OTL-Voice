# ==============================================================================
# OTL Timesheet Assistant — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` and fill in your credentials before running the app.
# NEVER commit the actual `.env` file containing live secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Oracle Cloud Infrastructure (OCI) Credentials & GenAI
# ------------------------------------------------------------------------------
# OCID of the compartment where GenAI and Speech services are hosted
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..your_compartment_ocid_here

# OCI User and Tenancy OCIDs for API authentication
OCI_TENANCY_OCID=ocid1.tenancy.oc1..your_tenancy_ocid_here
OCI_USER_OCID=ocid1.user.oc1..your_user_ocid_here
OCI_FINGERPRINT=aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99
OCI_REGION=us-ashburn-1

# Path to the OCI API Private Key PEM file (local path or inside container e.g. /app/key.pem)
# Alternatively, supply inline PEM via OCI_PRIVATE_KEY
OCI_PRIVATE_KEY_PATH=./oci_api_key.pem
# OCI_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# OCI_PRIVATE_KEY_PASSPHRASE=your_passphrase_if_encrypted

# Fallback: OCI SDK profile in ~/.oci/config (used if individual credentials are omitted)
OCI_CONFIG_PROFILE=DEFAULT

# Custom OCI endpoints (optional, auto-derived from OCI_REGION by default)
# OCI_SERVICE_ENDPOINT=https://inference.generativeai.us-ashburn-1.oci.oraclecloud.com
# OCI_SPEECH_ENDPOINT=https://speech.aiservice.us-ashburn-1.oci.oraclecloud.com

# ------------------------------------------------------------------------------
# 2. GenAI Chat / Model Inference Settings
# ------------------------------------------------------------------------------
# Model deployed on OCI GenAI service
CHAT_MODEL_ID=google.gemini-2.5-flash
CHAT_TEMPERATURE=0.3
CHAT_TOP_P=0.95
CHAT_MAX_TOKENS=2048
REQUEST_TIMEOUT_SECONDS=300

# ------------------------------------------------------------------------------
# 3. OCI Speech Synthesis (TTS) Settings
# ------------------------------------------------------------------------------
TTS_VOICE_ID=Brian
TTS_MODEL_NAME=TTS_2_NATURAL
TTS_LANGUAGE_CODE=en-US
TTS_SAMPLE_RATE=22050
TTS_OUTPUT_FORMAT=MP3

# ------------------------------------------------------------------------------
# 4. Oracle Time and Labor (Fusion HCM) Integration
# ------------------------------------------------------------------------------
# Base REST API resource endpoint for time record event requests
OTL_BASE_URL=https://fa-epxp-test-saasfaprod1.fa.ocs.oraclecloud.com/hcmRestApi/resources/11.13.18.05/timeRecordEventRequests

# Service account credentials for upstream Oracle Fusion REST API
OTL_SERVICE_USERNAME=your_service_user@example.com
OTL_SERVICE_PASSWORD=your_service_account_password

# API Timeout for OTL requests (seconds)
OTL_TIMEOUT_SECONDS=30

# Enforce strict assignment checks against local reference DB before submitting to OTL
STRICT_ASSIGNMENT=true

# Default start hour for timecards when none is inferred (e.g. 9 for 9:00 AM)
DEFAULT_START_HOUR=9

# Default expenditure type string for project-based entries
DEFAULT_EXPENDITURE_TYPE=Professional Services

# ------------------------------------------------------------------------------
# 5. Session & Server Security Settings
# ------------------------------------------------------------------------------
# Set to 'true' in production with HTTPS/TLS; set to 'false' for local HTTP
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_SECONDS=28800

# Allowed CORS origins for local multi-server development (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ------------------------------------------------------------------------------
# 6. Database & Asset Paths
# ------------------------------------------------------------------------------

# Path to built frontend distribution (used by single-origin FastAPI container)
# FRONTEND_DIST=/app/frontend/dist
