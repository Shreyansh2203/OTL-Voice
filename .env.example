# ==============================================================================
# OTL-Voice Environment Variables Template
# Copy this file to .env and replace every placeholder before production use.
# Never commit .env, generated password hashes containing reusable credentials,
# private keys, session secrets, IdP tokens, or service-account credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION AND SESSION SECURITY
# ------------------------------------------------------------------------------
# Required in production. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# Production requires at least 32 bytes. Do not reuse this value across services.
SESSION_SECRET_KEY=

# Signed, HttpOnly session lifetime in seconds. Default: 28800 (8 hours).
SESSION_TTL_SECONDS=28800

# Secure browser cookies are mandatory in production. Set false only for local
# HTTP development. SameSite=none is accepted only when SESSION_COOKIE_SECURE=true.
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=strict

# Production must use an explicit HTTPS origin list. Separate values with commas;
# "*" is intentionally unsupported because credentialed cookies are allowed.
CORS_ORIGINS=https://replace-with-your-application-origin.example.com
APP_TIMEZONE=

# Administrative endpoint key. Leave blank to disable administrative mutations.
# Generate a random value; never reuse AUTH_PASSWORD or SESSION_SECRET_KEY.
ADMIN_API_KEY=

# ------------------------------------------------------------------------------
# 2. IDENTITY VERIFICATION
# ------------------------------------------------------------------------------
# Configure exactly one production identity method. OIDC takes precedence when
# OIDC_ISSUER and OIDC_AUDIENCE are both set. The OIDC JWT is submitted only as
# the login request's password field; the resulting API session is cookie-only.
# The OIDC person-number claim, not a caller-supplied username, selects the user.
# Example: OIDC_ISSUER=https://idp.example.com
OIDC_ISSUER=
# Example: OIDC_AUDIENCE=otl-voice-api
OIDC_AUDIENCE=
# Optional. When blank, standard OpenID discovery is fetched from OIDC_ISSUER.
OIDC_JWKS_URL=
# Comma-separated asymmetric algorithms only. RS256 is the interoperable default.
OIDC_ALGORITHMS=RS256
# Dot-separated claim paths are supported.
OIDC_PERSON_NUMBER_CLAIM=person_number
OIDC_USERNAME_CLAIM=preferred_username
OIDC_JWKS_CACHE_SECONDS=300
OIDC_DISCOVERY_CACHE_SECONDS=300
OIDC_JWKS_REFRESH_MIN_SECONDS=30
OIDC_HTTP_TIMEOUT_SECONDS=5

# Per-user local authentication for non-OIDC deployments. AUTH_USERS is a JSON
# object keyed by the exact person number (or case-insensitive username):
# AUTH_USERS='{"10021":"scrypt$32768$8$1$SALT_BASE64URL$HASH_BASE64URL"}'
# An explicit employeeId/username binding is also accepted:
# AUTH_USERS='{"alice":{"employeeId":"10021","username":"10021","password":"scrypt$32768$8$1$SALT_BASE64URL$HASH_BASE64URL"}}'
# Generate each hash without printing the plaintext password:
# python -c "import getpass; from backend.core.auth import hash_scrypt_password; print(hash_scrypt_password(getpass.getpass('Password: ')))"
# Supported work factors are encoded in each value: scrypt$N$r$p$salt$hash.
# The implementation currently accepts N=16384..1048576 (power of two), r=1..16,
# p=1..8, with a 256 MiB memory ceiling. The default is N=32768,r=8,p=1.
AUTH_USERS=

# Explicit legacy shared-password verifier. It is honored only when BOTH
# DEV_MODE=true or TEST_MODE=true and no OIDC/AUTH_USERS verifier is configured.
# Production ignores AUTH_PASSWORD and fails closed. This is not an employee
# credential and must never be used as a production default.
AUTH_PASSWORD=

# ------------------------------------------------------------------------------
# 3. REDIS SESSION STATE, REVOCATION, AND RATE LIMITING
# ------------------------------------------------------------------------------
# Redis is mandatory in production. Sessions are active-state records in Redis;
# logout and refresh create revoked jti entries with the remaining token TTL.
# Use rediss:// with a least-privilege Redis ACL outside a private host. Keep all
# Redis credentials out of source control and rotate them like other secrets.
REDIS_URL=redis://localhost:6379/0
REDIS_REQUIRED=true

# In-memory session/rate-limit fallback is accepted only when DEV_MODE or
# TEST_MODE is true, REDIS_REQUIRED=false, and this flag is explicitly true.
# It is ignored in production so Redis failures never validate sessions.
ALLOW_IN_MEMORY_SESSIONS=false

# Per-user WebSocket connection cap. The identity comes from the authenticated
# session, never from proxy IP.
WS_MAX_CONNECTIONS_PER_USER=5

# ------------------------------------------------------------------------------
# 4. TRUSTED REVERSE PROXIES
# ------------------------------------------------------------------------------
# X-Forwarded-For and X-Real-IP are ignored unless the immediate peer matches an
# entry here. Enter exact addresses or CIDRs only; wildcards are not supported.
# Leave blank for direct connections. With multiple proxies, list every hop that
# may append to X-Forwarded-For, from application-adjacent to outer proxies.
TRUSTED_PROXY_IPS=
TRUSTED_PROXY_CIDRS=

# ------------------------------------------------------------------------------
# 5. ENVIRONMENT FLAGS
# ------------------------------------------------------------------------------
# Never enable either flag in production.
DEV_MODE=false
TEST_MODE=false
CSP_DEV_MODE=false

# ------------------------------------------------------------------------------
# 6. SENTRY ERROR REPORTING
# ------------------------------------------------------------------------------
# Auth, chat, TTS, STT, and timecard events are dropped. Request bodies, cookies,
# auth headers, local variables, JWTs, passwords, and person numbers are scrubbed.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
# Profiling is forced off by the backend; do not raise this for sensitive flows.
SENTRY_PROFILES_SAMPLE_RATE=0.0

# ------------------------------------------------------------------------------
# 7. ORACLE FUSION CLOUD (HCM / OTL / PPM)
# ------------------------------------------------------------------------------
OTL_BASE_URL=https://<your-fusion-host>.fa.ocs.oraclecloud.com/hcmRestApi/resources/11.13.18.05/timeRecordEventRequests
OTL_SERVICE_USERNAME=replace-with-service-account-username
OTL_SERVICE_PASSWORD=
# FUSION_HOST_URL=https://<your-fusion-host>.fa.ocs.oraclecloud.com
# FUSION_PPM_BASE_URL=https://<your-fusion-host>.fa.ocs.oraclecloud.com/fscmRestApi/resources/11.13.18.05

# ------------------------------------------------------------------------------
# 8. ORACLE CLOUD INFRASTRUCTURE (OCI)
# ------------------------------------------------------------------------------
OCI_REGION=us-ashburn-1
OCI_COMPARTMENT_ID=replace-with-compartment-ocid
OCI_CONFIG_PROFILE=DEFAULT
# OCI_CONFIG_FILE=~/.oci/config
# OCI_TENANCY_OCID=replace-with-tenancy-ocid
# OCI_USER_OCID=replace-with-user-ocid
# OCI_FINGERPRINT=replace-with-fingerprint
# OCI_PRIVATE_KEY_PATH=/path/to/oci_api_key.pem

# ------------------------------------------------------------------------------
# 9. OCI AI AND SPEECH
# ------------------------------------------------------------------------------
CHAT_MODEL_ID=cohere.command-a-03-2025
CHAT_TEMPERATURE=0.3
TTS_VOICE_ID=Brian
TTS_MODEL_NAME=TTS_2_NATURAL
OCI_GENAI_REGION=us-ashburn-1
OCI_SPEECH_REGION=us-ashburn-1
