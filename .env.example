# ==============================================================================
# OTL-Voice Environment Variables Template
# Copy this file to .env and configure values for your environment.
# DO NOT commit .env containing real credentials or secret keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & SECURITY CONFIGURATION
# ------------------------------------------------------------------------------
# JWT Session Signing Secret (Required in production)
# Generate a cryptographically secure random string with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY=generate_a_secure_random_key_here

# Session cookie duration in seconds (Default: 28800 = 8 hours)
SESSION_TTL_SECONDS=28800

# Require HTTPS for session cookies ("true" in production, "false" for local HTTP dev)
SESSION_COOKIE_SECURE=false

# SameSite cookie policy ("lax", "strict", or "none")
# Note: "none" requires SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax

# Administrative API Key required for /api/admin/* endpoints (Header: X-Admin-Key)
ADMIN_API_KEY=your_secure_admin_api_key_here

# Master / Development Fallback Authentication Password (Optional)
# If set, validates user login against this password in non-IdP environments
AUTH_PASSWORD=

# Allowed CORS Origins (comma-separated list of origins)
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,http://localhost:4173,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:4173,http://127.0.0.1:8000,capacitor://localhost,https://localhost
APP_TIMEZONE=

# Trusted reverse proxy IPs for client IP extraction in X-Forwarded-For (comma-separated)
TRUSTED_PROXY_IPS=127.0.0.1,::1

# Environment Mode Flags ("true" or "false")
DEV_MODE=false
TEST_MODE=false
CSP_DEV_MODE=false

# ------------------------------------------------------------------------------
# 2. REDIS CONFIGURATION (OPTIONAL)
# Distributed rate limiting & distributed token blocklist
# If unset, the backend falls back gracefully to thread-safe in-memory storage.
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_REQUIRED=false

# ------------------------------------------------------------------------------
# 3. ORACLE FUSION CLOUD (HCM / OTL / PPM) CREDENTIALS
# ------------------------------------------------------------------------------
# Base URL for Oracle Fusion Cloud Time Recording REST API
OTL_BASE_URL=https://<your-fusion-host>.fa.ocs.oraclecloud.com/hcmRestApi/resources/11.13.18.05/timeRecordEventRequests

# Oracle Fusion integration service account credentials
OTL_SERVICE_USERNAME=your_service_account_username
OTL_SERVICE_PASSWORD=your_service_account_password

# Optional: Oracle Fusion Host and PPM Project REST API Base URLs
# FUSION_HOST_URL=https://<your-fusion-host>.fa.ocs.oraclecloud.com
# FUSION_PPM_BASE_URL=https://<your-fusion-host>.fa.ocs.oraclecloud.com/fscmRestApi/resources/11.13.18.05

# ------------------------------------------------------------------------------
# 4. ORACLE CLOUD INFRASTRUCTURE (OCI) CREDENTIALS
# For OCI Generative AI & Speech Services
# ------------------------------------------------------------------------------
OCI_REGION=us-ashburn-1
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..your_compartment_ocid_here

# If using ~/.oci/config authentication profile:
OCI_CONFIG_PROFILE=DEFAULT
# OCI_CONFIG_FILE=~/.oci/config

# If using inline/environment OCI credentials instead of ~/.oci/config:
# OCI_TENANCY_OCID=ocid1.tenancy.oc1..your_tenancy_ocid_here
# OCI_USER_OCID=ocid1.user.oc1..your_user_ocid_here
# OCI_FINGERPRINT=aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99
# OCI_PRIVATE_KEY_PATH=/path/to/oci_api_key.pem

# ------------------------------------------------------------------------------
# 5. OCI AI & SPEECH SERVICE CONFIGURATION
# ------------------------------------------------------------------------------
# OCI GenAI Model ID and generation parameters
CHAT_MODEL_ID=cohere.command-a-03-2025
CHAT_TEMPERATURE=0.3

# OCI Speech Text-to-Speech (TTS) configuration
TTS_VOICE_ID=Brian
TTS_MODEL_NAME=TTS_2_NATURAL

# Service region overrides if different from OCI_REGION
OCI_GENAI_REGION=us-ashburn-1
OCI_SPEECH_REGION=us-ashburn-1
