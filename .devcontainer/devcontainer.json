{
  "name": "OTL-Voice Dev Environment",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "forwardPorts": [
    8000,
    5173
  ],
  "postCreateCommand": "curl -LsSf https://astral.sh/uv/install.sh | sh && uv sync && pnpm install --frozen-lockfile",
  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "esbenp.prettier-vscode",
        "ms-python.python",
        "ms-python.mypy-type-checker"
      ]
    }
  }
}