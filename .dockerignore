# Docker reads .dockerignore (podman reads .containerignore); keep them in sync.
.venv/
venv/
env/
__pycache__/
**/__pycache__/
*.py[cod]
.git/
.gitignore
.env
*.pem
.streamlit/secrets.toml
.idea/
.vscode/
.DS_Store

# Node / frontend: install and build happen inside the image.
frontend/node_modules/
frontend/dist/
node_modules/
dist/

# Docs and deploy manifests aren't needed inside the runtime image.
docs/
deploy/

# The reference database is built inside the container on first start; never
# ship the host's copy (it holds locally-created employees).
data/
*.db
